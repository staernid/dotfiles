#!/bin/sh
# _bw — ensure Bitwarden CLI is installed, then run it
#
# Downloads the latest bw CLI from Bitwarden to $HOME/.local/bin if not
# already present, then exec's bw with all passed arguments.

set -e

BW_BIN="$HOME/.local/bin/bw"

# Install if missing
if [ ! -x "$BW_BIN" ]; then
  echo "Bitwarden CLI not found at $BW_BIN" >&2
  echo "Downloading latest release ..." >&2

  TMPDIR="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$TMPDIR'" EXIT

  ZIP="$TMPDIR/bw.zip"
  curl -fsSL "https://vault.bitwarden.com/download/?app=cli&platform=linux" -o "$ZIP"

  unzip -oq "$ZIP" -d "$TMPDIR"

  mkdir -p "$HOME/.local/bin"
  mv "$TMPDIR/bw" "$BW_BIN"
  chmod 755 "$BW_BIN"

  echo "Installed bw to $BW_BIN" >&2
fi

exec "$BW_BIN" "$@"
