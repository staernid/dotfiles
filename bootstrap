#!/bin/bash

# bootstrap — one-shot setup for a new machine
# Prerequisites, stow, theme links, next-steps.
#
# After bootstrap completes, run ./provision-secrets to pull SSH keys
# and other secrets from Bitwarden.

set -euo pipefail

# ── 1. Distro detection ───────────────────────
DISTRO=
if [[ -f /etc/os-release ]]; then
  . /etc/os-release
  case "${ID:-}" in
    arch|manjaro|endeavouros) DISTRO=arch ;;
    fedora)                   DISTRO=fedora ;;
    ubuntu|debian|linuxmint)  DISTRO=debian ;;
  esac
  # Fall back to ID_LIKE for unrecognised derivatives (e.g. Artix, CachyOS)
  if [[ -z "$DISTRO" && -n "${ID_LIKE:-}" ]]; then
    case "$ID_LIKE" in
      arch*)  DISTRO=arch ;;
      fedora) DISTRO=fedora ;;
      debian) DISTRO=debian ;;
    esac
  fi
fi

# ── 2. Check prerequisites ────────────────────
have() { command -v "$1" &>/dev/null; }

if ! have git; then
  echo "Missing: git"
  echo "Install git and re-run ./bootstrap."
  exit 1
fi

install_pkg() {
  case "$DISTRO" in
    arch)   sudo pacman -S --noconfirm --needed "$@" ;;
    fedora) sudo dnf install -y "$@" ;;
    debian) sudo apt-get update && sudo apt-get install -y "$@" ;;
    *)
      echo "Cannot determine package manager. Install manually: $*"
      exit 1
      ;;
  esac
}

if ! have stow; then
  echo "stow not found. Installing..."
  install_pkg stow
fi

# ── 3. Install zsh plugin packages ────────────
# Required by .zshrc: syntax highlighting, autosuggestions, fzf
if [[ -n "$DISTRO" ]]; then
  install_pkg zsh-syntax-highlighting zsh-autosuggestions fzf
else
  echo "Unknown OS. Skipping zsh plugin install."
  echo "Install fzf, zsh-syntax-highlighting, zsh-autosuggestions manually."
fi

# ── 4. Clone scripts repo ─────────────────────
SCRIPTS_DIR="$HOME/scripts"
if [[ ! -d "$SCRIPTS_DIR" ]]; then
  echo "Cloning git@github.com:staernid/scripts.git to $SCRIPTS_DIR ..."
  if ! git clone git@github.com:staernid/scripts.git "$SCRIPTS_DIR" 2>/dev/null; then
    echo "Note: Could not clone scripts repo (SSH keys may not be set up yet)."
    echo "      Run ./provision-secrets first, then re-run ./bootstrap."
  fi
else
  echo "Scripts repo already at $SCRIPTS_DIR"
fi

# ── 5. Validate dotfile.conf ──────────────────
if [[ ! -f dotfile.conf ]]; then
  if [[ -f dotfile.conf.dist ]]; then
    cp dotfile.conf.dist dotfile.conf
    echo ""
    echo "dotfile.conf created from dotfile.conf.dist."
    echo "Edit dotfile.conf to match this machine, then re-run ./bootstrap."
    echo ""
    exit 0
  else
    echo "Error: dotfile.conf missing and no dotfile.conf.dist template found."
    exit 1
  fi
fi

# ── 6. Stow packages & link themes ────────────
echo "Running deploy (stow + theme links) ..."
cd "$(dirname "$0")" && exec ./deploy
