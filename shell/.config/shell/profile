#!/usr/bin/env sh
# profile — executed on login shell setup. Set environment variables here.
# Strictly POSIX compliant. Portable across Fedora, Arch, Debian, Termux.

# Default applications
export EDITOR="nvim"
export VISUAL="nvim"
export BROWSER="firefox"
export PAGER="less -R"
export MANPAGER="nvim +Man!"

# XDG Base Directory specification
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# Tool-specific XDG config/data directories
export INPUTRC="$XDG_CONFIG_HOME/shell/inputrc"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export GOPATH="$XDG_DATA_HOME/go"
export GOMODCACHE="$XDG_CACHE_HOME/go/mod"
export LESSHISTFILE="$XDG_CACHE_HOME/less/history"
export PASSWORD_STORE_DIR="$XDG_DATA_HOME/password-store"

# UI / Desktop Integration
export GTK_USE_PORTAL=1
export MOZ_ENABLE_WAYLAND=1
export MOZ_USE_XINPUT2=1
export FZF_DEFAULT_OPTS="--layout=reverse --height 40%"

# Clean $PATH configuration (portable across Linux distros & Termux)
_add_to_path() {
    [ -n "$1" ] && [ -d "$1" ] && case ":$PATH:" in *":$1:"*) ;; *) PATH="$1:$PATH" ;; esac
}

_add_to_path "$HOME/.npm-global/bin"
_add_to_path "$GOPATH/bin"
_add_to_path "$CARGO_HOME/bin"
_add_to_path "$HOME/scripts"
_add_to_path "$HOME/.local/bin/cron"
_add_to_path "$HOME/.local/bin/github-release-manager"
_add_to_path "$HOME/.local/bin"
[ -n "$PREFIX" ] && _add_to_path "$PREFIX/bin"

export PATH
unset -f _add_to_path
