# aliasrc — shell aliases

# Editor aliases
if command -v nvim &>/dev/null; then
  alias vim="nvim"
  alias vimdiff="nvim -d"
fi
alias e='$EDITOR'
alias v='$EDITOR'

# Safety & verbosity defaults
alias cp="cp -iv"
alias mv="mv -iv"
alias rm="rm -vI"
alias mkd="mkdir -pv"
alias bc="bc -ql"
alias rsync="rsync -vrPlu"

# System update shortcut
alias up="update_system"

# Colorized output
alias ls="ls -hN --color=auto --group-directories-first"
alias grep="grep --color=auto"
alias diff="diff --color=auto"
alias ip="ip -color=auto"

# Short shortcuts
alias ka="killall"
alias g="git"
alias cx="chmod +x"
alias myp="ps -fjH -u \$USER"

# Git & GitHub CLI aliases
alias adog="git log --all --decorate --oneline --graph"
alias gpr="gh pr checkout"
alias gpv="gh pr view --web"

# Wayland Clipboard shortcuts
if command -v wl-copy &>/dev/null; then
  alias cpy="wl-copy"
  alias pst="wl-paste"
fi

# Pacman (Arch Linux) aliases
alias pac="pacman"
alias pacs="pacman -S"
alias pacss="pacman -Ss"
alias pacsyu="pacman -Syu"
alias pacrns="pacman -Rns"

# Void Linux aliases
alias xi="sudo xbps-install"
alias xr="sudo xbps-remove -R"
alias xq="xbps-query -R"
alias xs="xbps-query -Rs"

# Media & Downloading
alias yt="yt-dlp --embed-metadata -i --default-search 'ytsearch'"
alias yta="yt-dlp --embed-metadata --default-search 'ytsearch' -i -x -f bestaudio/best"
alias ytt="yt-dlp --skip-download --write-thumbnail"
alias ffmpeg="ffmpeg -hide_banner"
alias bat="cat /sys/class/power_supply/BAT?/capacity"
