#!/usr/bin/env bash
#
# update-godot - Self-contained updater script for Godot Engine on Linux
# Downloads the latest stable release (or a specified version) of Godot
# and installs it to ~/.local/bin/godot.
#
# Usage:
#   update-godot [version] [mono] [--force]
#

set -euo pipefail

# --- Color configuration ---
G_NC=$(tput sgr0 2>/dev/null || echo "")
G_RED=$(tput setaf 1 2>/dev/null || echo "")
G_GREEN=$(tput setaf 2 2>/dev/null || echo "")
G_YELLOW=$(tput setaf 3 2>/dev/null || echo "")
G_BLUE=$(tput setaf 4 2>/dev/null || echo "")

log_info() {
  printf "%s[INFO]%s %s\\n" "${G_BLUE}" "${G_NC}" "$*"
}

log_success() {
  printf "%s[SUCCESS]%s %s\\n" "${G_GREEN}" "${G_NC}" "$*"
}

log_warn() {
  printf "%s[WARN]%s %s\\n" "${G_YELLOW}" "${G_NC}" "$*"
}

log_error() {
  printf "%s[ERROR]%s %s\\n" "${G_RED}" "${G_NC}" "$*" >&2
}

# --- Dependency check ---
for cmd in curl unzip jq; do
  if ! command -v "$cmd" &>/dev/null; then
    log_error "Required dependency '$cmd' is missing. Please install it."
    exit 1
  fi
done

# --- Parameter Parsing ---
MONO=false
FORCE=false
VERSION=""

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      echo "Godot Engine Updater"
      echo "Usage: $(basename "$0") [version] [mono] [options]"
      echo
      echo "Arguments:"
      echo "  version      Specify a version to download (e.g., 4.7, 4.6.3-stable)."
      echo "               If omitted, defaults to the latest stable release."
      echo "  mono         Download the Mono (.NET) build of Godot."
      echo
      echo "Options:"
      echo "  -f, --force  Force re-installation even if already up-to-date."
      echo "  -h, --help   Show this help message."
      exit 0
      ;;
    mono|Mono|MONO)
      MONO=true
      ;;
    -f|--force)
      FORCE=true
      ;;
    *)
      if [[ "$arg" =~ ^[0-9] ]]; then
        VERSION="$arg"
      else
        log_error "Unknown argument: $arg"
        echo "Run with -h or --help for usage." >&2
        exit 1
      fi
      ;;
  esac
done

# --- Architecture detection ---
ARCH=$(uname -m)
if [[ "$ARCH" == "x86_64" ]]; then
  ARCH="x86_64"
elif [[ "$ARCH" == "aarch64" || "$ARCH" == "arm64" ]]; then
  ARCH="arm64"
else
  log_error "Unsupported architecture: $ARCH"
  exit 1
fi

# --- Resolve version ---
if [[ -z "$VERSION" ]]; then
  log_info "Fetching latest stable version from GitHub..."
  VERSION=$(curl -s https://api.github.com/repos/godotengine/godot/releases/latest | jq -r '.tag_name')
  if [[ -z "$VERSION" || "$VERSION" == "null" ]]; then
    log_error "Failed to fetch latest version from GitHub."
    exit 1
  fi
else
  # Normalize version (e.g. 4.7 -> 4.7-stable)
  if [[ "$VERSION" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
    VERSION="${VERSION}-stable"
  fi
fi

MONO_TEXT="Standard"
if [ "$MONO" = true ]; then
  MONO_TEXT="Mono"
fi

INSTALL_DIR="$HOME/.local/bin"

# --- Check if update is necessary ---
if [[ -x "$INSTALL_DIR/godot" ]]; then
  CURRENT_VERSION_STRING=$("$INSTALL_DIR/godot" --version 2>/dev/null || echo "")
  if [[ -n "$CURRENT_VERSION_STRING" ]]; then
    # Extract clean version format matching the tag name (e.g., 4.7-stable)
    CLEAN_VERSION=${CURRENT_VERSION_STRING%%.official*}
    if [[ "$CLEAN_VERSION" =~ (.*)\.(stable|rc[0-9]+|beta[0-9]+|alpha[0-9]+|dev[0-9]+) ]]; then
      CLEAN_VERSION="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"
    fi

    # Detect if the installed build is Mono or Standard
    IS_MONO_INSTALLED=false
    if [[ "$CURRENT_VERSION_STRING" == *".mono."* ]]; then
      IS_MONO_INSTALLED=true
    fi

    log_info "Currently installed: Godot $CLEAN_VERSION ($( [ "$IS_MONO_INSTALLED" = true ] && echo "Mono" || echo "Standard" ))"

    if [[ "$FORCE" = false && "$CLEAN_VERSION" == "$VERSION" && "$IS_MONO_INSTALLED" == "$MONO" ]]; then
      log_success "Godot $VERSION ($MONO_TEXT) is already up-to-date."
      # Proceed to generate desktop entry in case it was missing
    else
      # Update is needed, download and install it
      log_info "Target: Godot $VERSION ($MONO_TEXT) for $ARCH"

      # --- Construct URL ---
      if [ "$MONO" = true ]; then
        URL="https://github.com/godotengine/godot/releases/download/${VERSION}/Godot_v${VERSION}_mono_linux_${ARCH}.zip"
      else
        URL="https://github.com/godotengine/godot/releases/download/${VERSION}/Godot_v${VERSION}_linux.${ARCH}.zip"
      fi

      # --- Download and install ---
      TEMP_DIR=$(mktemp -d)
      # Ensure cleanup of temp dir on exit
      trap 'rm -rf "$TEMP_DIR"' EXIT

      log_info "Downloading Godot from: $URL"
      if ! curl -L -f -# -o "$TEMP_DIR/godot.zip" "$URL"; then
        log_error "Download failed. Please check the version or your internet connection."
        exit 1
      fi

      log_info "Extracting archive..."
      if ! unzip -q "$TEMP_DIR/godot.zip" -d "$TEMP_DIR/extracted"; then
        log_error "Failed to extract ZIP file."
        exit 1
      fi

      # Locate the binary in extracted files
      BINARY_PATH=$(find "$TEMP_DIR/extracted" -type f -name "Godot_v*" ! -name "*.dll" ! -name "*.xml" ! -name "*.pdb" ! -name "*.json" ! -name "*.nupkg" ! -name "*.snupkg" | head -n 1)

      if [[ -z "$BINARY_PATH" ]]; then
        log_error "Could not find Godot executable inside the extracted ZIP."
        exit 1
      fi

      mkdir -p "$INSTALL_DIR"

      if [ "$MONO" = true ]; then
        GODOTSHARP_PATH=$(find "$TEMP_DIR/extracted" -type d -name "GodotSharp" | head -n 1)
        if [[ -z "$GODOTSHARP_PATH" ]]; then
          log_error "Could not find GodotSharp directory in the Mono ZIP."
          exit 1
        fi

        log_info "Installing GodotSharp directory..."
        rm -rf "$INSTALL_DIR/GodotSharp"
        mv "$GODOTSHARP_PATH" "$INSTALL_DIR/GodotSharp"
      else
        # If installing standard version, clean up old GodotSharp directory to avoid mismatch
        if [ -d "$INSTALL_DIR/GodotSharp" ]; then
          log_info "Removing obsolete GodotSharp directory..."
          rm -rf "$INSTALL_DIR/GodotSharp"
        fi
      fi

      log_info "Installing Godot binary to $INSTALL_DIR/godot..."
      rm -f "$INSTALL_DIR/godot"
      mv "$BINARY_PATH" "$INSTALL_DIR/godot"
      chmod +x "$INSTALL_DIR/godot"

      log_success "Successfully installed Godot $VERSION ($MONO_TEXT) to $INSTALL_DIR/godot"
    fi
  fi
fi

# --- Create desktop entry and download icon ---
ICON_DIR="$HOME/.local/share/icons"
mkdir -p "$ICON_DIR"
if [ ! -f "$ICON_DIR/godot.svg" ] || [ "$(wc -c < "$ICON_DIR/godot.svg" 2>/dev/null || echo 0)" -lt 100 ]; then
  log_info "Downloading Godot icon..."
  curl -s -L -o "$ICON_DIR/godot.svg" "https://godotengine.org/assets/press/icon_color.svg" || true
fi

DESKTOP_DIR="$HOME/.local/share/applications"
mkdir -p "$DESKTOP_DIR"
DESKTOP_FILE="$DESKTOP_DIR/godot.desktop"
log_info "Creating desktop entry at $DESKTOP_FILE..."
cat <<EOF > "$DESKTOP_FILE"
[Desktop Entry]
Name=Godot Engine
GenericName=2D and 3D Game Engine
Comment=Multi-platform 2D and 3D game engine
Exec=$INSTALL_DIR/godot %f
Icon=$ICON_DIR/godot.svg
Terminal=false
Type=Application
Categories=Development;IDE;
MimeType=application/x-godot-project;
EOF

log_success "Desktop entry registered successfully."
