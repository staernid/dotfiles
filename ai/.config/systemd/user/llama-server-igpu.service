[Unit]
Description=Llama Server Service
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
RestartSec=3
WorkingDirectory=/home/staernid/llama
ExecStart=/usr/bin/llama-server --port 8081 --models-preset /home/staernid/llama/models.ini
Environment=HOME=/home/staernid
Environment=GGML_VK_VISIBLE_DEVICES=0

[Install]
WantedBy=default.target
