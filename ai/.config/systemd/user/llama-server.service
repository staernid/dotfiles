[Unit]
Description=Llama Server Service
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
RestartSec=3
WorkingDirectory=%h/llama
ExecStart=/usr/bin/llama-server --models-preset %h/llama/models.ini
Environment=GGML_VK_VISIBLE_DEVICES=1

[Install]
WantedBy=default.target
