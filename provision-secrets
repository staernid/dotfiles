#!/bin/bash

# provision-secrets — pull SSH keys and config secrets from Bitwarden vault
#
# Conventions:
#   dotfiles/ssh/<name>       →  ~/.ssh/<name>         (SSH key, type 2)
#   dotfiles/config/<path>    →  ~/.config/<path>      (secure note, notes field)
#
# Idempotent: re-running safely overwrites files.

set -euo pipefail

BW_SESSION="${BW_SESSION:-}"

# ── 1. Check Bitwarden CLI ────────────────────
if ! command -v bw &>/dev/null; then
  echo "Error: Bitwarden CLI (bw) not found."
  echo "Install it from https://bitwarden.com/help/cli/"
  exit 1
fi

# ── 2. Authenticate / unlock session ──────────
_status() { bw status | jq -r '.status'; }

case "$(_status)" in
  unauthenticated)
    echo "Not logged into Bitwarden. Run 'bw login' first, then re-run this script."
    exit 1
    ;;
  locked)
    echo "Bitwarden vault is locked. Unlocking..."
    session="$(bw unlock --raw)"
    BW_SESSION="$session"
    export BW_SESSION
    ;;
  unlocked)
    ;;  # proceed
esac

list() { bw list items --search "$1" | jq -c '.[]'; }
get_field() { echo "$item" | jq -r "$1 // empty"; }

written=0

# ── 3. Fetch SSH keys ─────────────────────────
echo "--- SSH keys ---"
while IFS= read -r item; do
  [[ -z "$item" ]] && continue
  name="$(get_field '.name')"
  # Extract the key name: "dotfiles/ssh/github" → "github"
  key_name="${name##*/}"
  priv="$(get_field '.sshKey.privateKey')"
  pub="$(get_field '.sshKey.publicKey')"

  if [[ -n "$priv" || -n "$pub" ]]; then
    mkdir -p "$HOME/.ssh"
    if [[ -n "$priv" ]]; then
      echo "$priv" > "$HOME/.ssh/$key_name"
      chmod 600 "$HOME/.ssh/$key_name"
      echo "  Wrote  ~/.ssh/$key_name"
    fi
    if [[ -n "$pub" ]]; then
      echo "$pub" > "$HOME/.ssh/$key_name.pub"
      chmod 600 "$HOME/.ssh/$key_name.pub"
      echo "  Wrote  ~/.ssh/$key_name.pub"
    fi
    ((written++))
  else
    echo "  Skip   $name (no sshKey fields)"
  fi
done < <(list "dotfiles/ssh/")

# ── 4. Fetch config secrets ───────────────────
echo ""
echo "--- Config secrets ---"
while IFS= read -r item; do
  [[ -z "$item" ]] && continue
  name="$(get_field '.name')"
  # Extract the path: "dotfiles/config/git/config" → "git/config"
  rel_path="${name#dotfiles/config/}"
  notes="$(get_field '.notes')"

  if [[ -n "$notes" ]]; then
    target="$HOME/.config/$rel_path"
    mkdir -p "$(dirname "$target")"
    echo "$notes" > "$target"
    chmod 600 "$target"
    echo "  Wrote  ~/.config/$rel_path"
    ((written++))
  else
    echo "  Skip   $name (empty notes field)"
  fi
done < <(list "dotfiles/config/")

# ── 5. Summary ────────────────────────────────
echo ""
echo "Done. $written file(s) written."
